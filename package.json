{
  "name": "storm-rare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-info.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "audit": "vitest run src/engine/audit.test.ts --reporter=verbose --silent=false",
    "inspect:answers": "node scripts/inspect-answer-bank.mjs",
    "diagnostics": "node scripts/build-info.mjs --print",
    "package:site": "node scripts/package-site.mjs",
    "audit:quality": "node scripts/audit-quality.mjs",
    "audit:phase4b": "node scripts/audit-phase4b.mjs",
    "audit:phase5a": "node scripts/audit-phase5a.mjs",
    "audit:phase5b": "node scripts/audit-phase5b.mjs",
    "audit:phase5c": "node scripts/audit-phase5c.mjs",
    "audit:catalog-diff": "node scripts/catalog-diff-phase5c.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
